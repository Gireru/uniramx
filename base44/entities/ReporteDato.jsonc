{
  "name": "ReporteDato",
  "type": "object",
  "properties": {
    "convocatoria_id": {
      "type": "string"
    },
    "motivo": {
      "type": "string",
      "enum": [
        "fecha_incorrecta",
        "enlace_roto",
        "posible_fraude",
        "otro"
      ]
    },
    "detalle": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "nuevo",
        "revisado"
      ],
      "default": "nuevo"
    }
  },
  "required": [
    "convocatoria_id",
    "motivo"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}