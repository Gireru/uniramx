{
  "name": "Guardado",
  "type": "object",
  "properties": {
    "perfil_id": {
      "type": "string"
    },
    "convocatoria_id": {
      "type": "string"
    },
    "avisame_cuando_abra": {
      "type": "boolean"
    },
    "nota": {
      "type": "string"
    }
  },
  "required": [
    "convocatoria_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}